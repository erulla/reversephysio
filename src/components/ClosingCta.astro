---
import { siteConfig } from "../lib/site-config";
---

<section class="bg-forest py-16 sm:py-20">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      Ready to <span class="accent-word text-mint">reclaim life</span>?
    </h2>
    <p class="mt-4 text-lg text-cream/80">
      Message us on WhatsApp to book your first session — we will confirm the right location and
      time for you.
    </p>
    <div class="mt-8 flex justify-center">
      <a
        href={siteConfig.whatsapp.bookingHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-mint px-7 py-3.5 text-base font-semibold text-forest transition-transform hover:scale-[1.03]"
      >
        Book on WhatsApp
      </a>
    </div>
  </div>
</section>
