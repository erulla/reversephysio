---
import { siteConfig, mapEmbedSrc } from "../lib/site-config";
---

<section id="clinic-locations-singapore" class="bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold tracking-tight text-forest sm:text-4xl">
        Our <span class="accent-word text-teal">locations</span>
      </h2>
      <p class="mt-4 text-lg text-forest/70">
        {siteConfig.hoursNote} &middot; Tuesday–Saturday, 9:00 AM–8:00 PM &middot; Closed Sunday–Monday.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
      {
        siteConfig.locations.map((location) => (
          <div class="overflow-hidden rounded-3xl border border-forest/10">
            <div class="overflow-hidden">
              <iframe
                src={mapEmbedSrc(location.fullAddress)}
                title={`Map showing the ${siteConfig.name} clinic at ${location.name}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="h-64 w-full border-0"
              />
            </div>
            <div class="p-6 sm:p-8">
              <h3 class="text-lg font-bold text-forest">{location.name}</h3>
              <p class="mt-1 text-sm text-forest/70">{location.fullAddress}</p>
              <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-teal/10 px-3 py-1.5 text-sm font-semibold text-teal">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M12 2C7 2 4 3.5 4 8v7a3 3 0 0 0 3 3l-2 2v1h14v-1l-2-2a3 3 0 0 0 3-3V8c0-4.5-3-6-8-6Zm-5 6h10M8 16h.01M16 16h.01"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {location.mrt}
              </p>
              <a
                href={siteConfig.whatsapp.bookingHref}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center gap-2 rounded-full bg-mint px-5 py-2.5 text-sm font-semibold text-forest transition-transform hover:scale-[1.03]"
              >
                Book on WhatsApp
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-6 rounded-3xl bg-cream p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-teal">Reach us directly</h3>
        <ul class="mt-3 space-y-2 text-forest">
          <li>
            <a
              href={siteConfig.whatsapp.generalHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg font-semibold hover:text-teal"
            >
              WhatsApp: {siteConfig.whatsapp.display}
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class="text-lg font-semibold hover:text-teal">
              {siteConfig.email}
            </a>
          </li>
        </ul>
      </div>

      <dl class="divide-y divide-forest/10 text-sm sm:w-64">
        {
          siteConfig.hours.map((h) => (
            <div class="flex items-center justify-between py-2">
              <dt class="text-forest/70">{h.label}</dt>
              <dd class="font-medium text-forest">{h.timeLabel}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
