---
import { siteConfig } from "../lib/site-config";

const year = new Date().getFullYear();
---

<footer class="bg-teal text-white">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 border-b border-white/15 pb-10 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-xl font-extrabold">
          Reverse <span class="accent-word">Physio</span>
        </p>
        <p class="mt-2 text-sm text-white/75">{siteConfig.tagline}</p>
      </div>
      <a
        href={siteConfig.whatsapp.bookingHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Book an appointment with ${siteConfig.name} on WhatsApp`}
        class="inline-flex items-center justify-center gap-2 self-start rounded-full bg-mint px-6 py-3 text-sm font-semibold text-forest transition-transform hover:scale-[1.03] sm:self-auto"
      >
        Book on WhatsApp
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-white/60">Explore</h3>
        <ul class="mt-4 space-y-2 text-sm">
          {
            siteConfig.nav.map((item) => (
              <li>
                <a href={item.href} class="text-white/85 hover:text-mint">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-white/60">Locations</h3>
        <ul class="mt-4 space-y-3 text-sm text-white/85">
          {
            siteConfig.locations.map((location) => (
              <li>
                <p class="font-medium text-white">{location.shortName}</p>
                <p class="text-white/70">{location.fullAddress}</p>
                <p class="mt-0.5 text-mint">{location.mrt}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-white/60">Contact</h3>
        <ul class="mt-4 space-y-2 text-sm text-white/85">
          <li>
            <a href={siteConfig.whatsapp.generalHref} target="_blank" rel="noopener noreferrer" class="hover:text-mint">
              WhatsApp: {siteConfig.whatsapp.display}
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-mint">{siteConfig.email}</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-white/60">Hours</h3>
        <ul class="mt-4 space-y-2 text-sm text-white/85">
          <li class="text-white/70">{siteConfig.hoursNote}</li>
          {siteConfig.hours.map((h) => (
            <li>
              {h.label}: <span class="font-medium text-white">{h.timeLabel}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/15 pt-6 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {siteConfig.name}. All rights reserved.</p>
      <a href={`${import.meta.env.BASE_URL}privacy-policy`} class="hover:text-mint">Privacy Policy</a>
    </div>
  </div>
</footer>
