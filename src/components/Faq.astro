---
import FaqAccordion from "./FaqAccordion.tsx";
import { faqItems } from "../lib/content";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
        .map((p) => (p.label ? `${p.label}: ${p.text}` : p.text))
        .join(" "),
    },
  })),
};
---

<section id="physiotherapy-faq-singapore" class="bg-cream py-20 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-forest sm:text-4xl">
        Common <span class="accent-word text-teal">questions</span>
      </h2>
      <p class="mt-4 text-lg text-forest/70">
        Can't find what you're looking for? Message us on WhatsApp — we're happy to help.
      </p>
    </div>

    <div class="mt-10">
      <FaqAccordion client:visible items={faqItems} />
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</section>
