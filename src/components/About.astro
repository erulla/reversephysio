---
import { Image } from "astro:assets";
import eugeneHeadshot from "../assets/images/eugene-headshot.jpg";
import { practitioner } from "../lib/content";
---

<section id="about-eugene-foo" class="bg-forest py-20 text-cream sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-12">
      <div class="order-2 md:order-1">
        <p class="text-sm font-semibold uppercase tracking-wide text-mint">About your physiotherapist</p>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          {practitioner.name}
        </h2>

        <ul class="mt-4 space-y-1 text-sm font-medium text-cream/80">
          {practitioner.roles.map((role) => <li>{role}</li>)}
        </ul>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Qualifications">
          {
            practitioner.qualifications.map((qualification) => (
              <li class="rounded-full border border-mint/30 bg-white/5 px-4 py-2 text-sm font-medium text-cream/90">
                {qualification}
              </li>
            ))
          }
        </ul>

        <p class="mt-6 text-lg leading-relaxed text-cream/85">{practitioner.bio}</p>
        <p class="mt-4 text-base leading-relaxed text-cream/70">{practitioner.gurkhaLine}</p>
      </div>

      <div class="order-1 md:order-2">
        <div class="aspect-square w-full overflow-hidden rounded-3xl">
          <Image
            src={eugeneHeadshot}
            alt="Eugene Foo, Lead Physiotherapist and Founder of Reverse Physio"
            class="h-full w-full object-cover object-center"
            widths={[400, 700, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
          />
        </div>
      </div>
    </div>
  </div>
</section>
