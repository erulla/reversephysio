---
import MobileMenu from "./MobileMenu.tsx";
import { siteConfig } from "../lib/site-config";
---

<header class="sticky top-0 z-50 border-b border-forest/10 bg-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="#top" class="text-xl font-extrabold tracking-tight text-teal">
      Reverse <span class="accent-word text-teal">Physio</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm font-medium text-forest">
        {
          siteConfig.nav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-teal">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={siteConfig.whatsapp.bookingHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Book an appointment with ${siteConfig.name} on WhatsApp`}
        class="inline-flex items-center gap-2 rounded-full bg-mint px-4 py-2.5 text-sm font-semibold text-forest transition-transform hover:scale-[1.03] sm:px-5"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.4c1.5.8 3.1 1.2 4.8 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3C4.2 15 3.8 13.5 3.8 12c0-4.5 3.7-8.2 8.2-8.2s8.2 3.7 8.2 8.2-3.7 8.2-8.2 8.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.7.8-.8.9-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5.1-.1.2-.3.4-.4.1-.1.2-.2.2-.4.1-.1 0-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2 1 2.4c.1.2 1.6 2.4 3.8 3.4.5.2.9.4 1.3.5.5.2 1 .1 1.3.1.4-.1 1.2-.5 1.4-1 .2-.5.2-.9.1-1Z"
          />
        </svg>
        Book on WhatsApp
      </a>

      <MobileMenu client:load navItems={siteConfig.nav} />
    </div>
  </div>
</header>
